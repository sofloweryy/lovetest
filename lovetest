<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>💖 测测命中另一半的星座与MBTI</title>
<!-- 引入 Supabase 客户端 SDK -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root {
  --primary-gradient: linear-gradient(135deg, #ff758f 0%, #ff4d6d 100%);
  --bg-gradient: linear-gradient(135deg, #fff0f3 0%, #f3e8ff 100%);
  --card-bg: #ffffff;
  --text-main: #2b2d42;
  --text-sub: #8d99ae;
  --accent-bg: #fff5f7;
  --border-color: #ffccd5;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  -webkit-tap-highlight-color: transparent;
}

body {
  background: var(--bg-gradient);
  color: var(--text-main);
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 8px 16px 32px 16px;
  position: relative;
  overflow-x: hidden;
}

.romantic-header-art {
  position: relative;
  width: 100%;
  max-width: 500px;
  height: 32px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 12px;
  pointer-events: none;
}

.art-heart {
  width: 10px;
  height: 10px;
  background: #ff4d6d;
  transform: rotate(45deg);
  position: relative;
  animation: pulseGlow 2s ease-in-out infinite alternate;
  opacity: 0.7;
}

.art-heart::before,
.art-heart::after {
  content: '';
  width: 10px;
  height: 10px;
  background: #ff4d6d;
  border-radius: 50%;
  position: absolute;
}

.art-heart::before {
  left: -5px;
  top: 0;
}

.art-heart::after {
  left: 0;
  top: -5px;
}

.art-star {
  width: 12px;
  height: 12px;
  background: #ffb703;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  animation: starTwinkle 1.5s ease-in-out infinite alternate;
  opacity: 0.8;
}

.art-bubble {
  width: 16px;
  height: 10px;
  background: #ff758f;
  border-radius: 6px;
  position: relative;
  opacity: 0.5;
  animation: floatUp 3s ease-in-out infinite alternate;
}

.art-bubble::after {
  content: '';
  position: absolute;
  bottom: -3px;
  left: 4px;
  width: 0;
  height: 0;
  border-left: 3px solid transparent;
  border-right: 3px solid transparent;
  border-top: 4px solid #ff758f;
}

@keyframes pulseGlow {
  0% { transform: rotate(45deg) scale(0.9); opacity: 0.5; }
  100% { transform: rotate(45deg) scale(1.15); opacity: 0.85; }
}

@keyframes starTwinkle {
  0% { transform: scale(0.8) rotate(0deg); opacity: 0.4; }
  100% { transform: scale(1.1) rotate(15deg); opacity: 0.9; }
}

@keyframes floatUp {
  0% { transform: translateY(2px); }
  100% { transform: translateY(-3px); }
}

.main-content {
  width: 100%;
  max-width: 500px;
}

.quiz-card {
  background: #ffffff;
  border-radius: 20px;
  padding: 22px;
  box-shadow: 0 15px 35px rgba(255, 77, 109, 0.12);
  border: 2px solid #ffe5e9;
  position: relative;
}

h1 {
  font-size: 22px;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 6px;
  text-align: center;
  font-weight: 900;
  letter-spacing: 0.5px;
}

p.subtitle {
  font-size: 13px;
  color: var(--text-sub);
  margin-bottom: 20px;
  text-align: center;
  font-weight: 500;
}

.form-group {
  margin-bottom: 18px;
  text-align: left;
}

label.question-title {
  display: block;
  font-size: 14.5px;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--text-main);
  line-height: 1.4;
}

select {
  width: 100%;
  padding: 12px;
  border: 1.5px solid var(--border-color);
  border-radius: 12px;
  background-color: var(--accent-bg);
  font-size: 14px;
  color: var(--text-main);
  outline: none;
  font-weight: 600;
}

button.submit-btn {
  width: 100%;
  padding: 16px;
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  border-radius: 14px;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 10px;
  box-shadow: 0 6px 20px rgba(255, 77, 109, 0.35);
  letter-spacing: 1px;
}

button.submit-btn:active {
  transform: scale(0.98);
}

#result {
  margin-top: 10px;
  display: none;
}

.share-card {
  background: #ffffff;
  border-radius: 20px;
  padding: 22px;
  box-shadow: 0 15px 35px rgba(255, 77, 109, 0.15);
  border: 2px solid #ffe5e9;
  position: relative;
}

.poster-header {
  text-align: center;
  margin-bottom: 16px;
  padding-bottom: 14px;
  border-bottom: 1.5px dashed var(--border-color);
}

.poster-tag {
  display: inline-block;
  background: var(--primary-gradient);
  color: #fff;
  padding: 4px 14px;
  border-radius: 18px;
  font-size: 11.5px;
  font-weight: 800;
  margin-bottom: 10px;
}

.user-badge {
  font-size: 13px;
  color: var(--text-sub);
  margin-bottom: 6px;
  font-weight: 500;
}

.user-badge span {
  color: #ff4d6d;
  font-weight: bold;
}

.match-target {
  font-size: 18px;
  color: var(--text-main);
  font-weight: 900;
  line-height: 1.4;
}

.match-target-highlight {
  color: #ff4d6d;
  font-size: 21px;
  display: block;
  margin-top: 4px;
}

.score-badge {
  background: var(--accent-bg);
  border: 1.5px solid #ffccd5;
  border-radius: 12px;
  padding: 10px;
  text-align: center;
  margin-bottom: 16px;
}

.score-num {
  font-size: 24px;
  font-weight: 900;
  color: #ff4d6d;
}

.score-sub {
  font-size: 12px;
  color: var(--text-sub);
  font-weight: 600;
  margin-top: 2px;
}

.analysis-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 18px;
}

.analysis-item {
  background: #fff8f9;
  border-left: 4px solid #ff4d6d;
  border-radius: 0 12px 12px 0;
  padding: 12px 14px;
}

.item-title {
  font-size: 13.5px;
  font-weight: 800;
  color: #ff4d6d;
  margin-bottom: 4px;
}

.item-desc {
  font-size: 13px;
  line-height: 1.5;
  color: #4a4e69;
  font-weight: 500;
}

.poster-footer {
  padding-top: 14px;
  border-top: 1.5px solid #f0f0f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-brand .brand-name {
  font-size: 12px;
  font-weight: bold;
  color: var(--text-main);
}

.footer-brand .brand-sub {
  font-size: 10px;
  color: #aaa;
}

.contact-btn {
  background: linear-gradient(135deg, #ff758f 0%, #ff4d6d 100%);
  color: #fff;
  font-size: 11.5px;
  padding: 6px 14px;
  border-radius: 16px;
  font-weight: bold;
  cursor: pointer;
  border: none;
  box-shadow: 0 3px 10px rgba(255, 77, 109, 0.3);
  display: inline-flex;
  align-items: center;
  gap: 3px;
  white-space: nowrap;
}

.qr-modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(5px);
  z-index: 9999;
  justify-content: center;
  align-items: center;
}

.qr-card {
  background: #fff;
  padding: 28px 24px;
  border-radius: 20px;
  text-align: center;
  width: 85%;
  max-width: 310px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

.qr-card h3 {
  font-size: 17px;
  color: #2b2d42;
  margin-bottom: 6px;
}

.qr-card p {
  font-size: 12.5px;
  color: #8d99ae;
  margin-bottom: 16px;
}

.wechat-box {
  background: #fff0f3;
  border: 1.5px dashed #ff4d6d;
  color: #ff4d6d;
  font-size: 17px;
  font-weight: 900;
  padding: 12px;
  border-radius: 12px;
  margin-bottom: 14px;
  user-select: all;
}

.close-btn {
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  padding: 13px 24px;
  border-radius: 14px;
  font-weight: bold;
  font-size: 14.5px;
  cursor: pointer;
  width: 100%;
  box-shadow: 0 5px 15px rgba(255, 77, 109, 0.35);
}
</style>
</head>
<body>

<div class="romantic-header-art">
