</div>

<script>
  const SUPABASE_URL = 'https://hrgzmwtgpacdxifcevwy.supabase.co'; 
  const SUPABASE_ANON_KEY = 'sb_publishable_4XcXlLh77BtvmIajOGbpPA_T7d6b9fu';
  const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  const urlParams = new URLSearchParams(window.location.search);
  const currentCode = urlParams.get('code');

  const targetMap = {
    'ESTP': {
      type: 'ISFJ 守卫者',
      zodiac: '双鱼座',
      desc0: '✨ 你的本命人格是【ESTP】~ 另一半往往自带【温柔包容、极具耐心】的特质！',
      desc1: '💖 你们的组合充满宿命感！【双鱼座】的柔情似水与无条件包容，能瞬间融化你外表的玩世不恭。',
      desc2: '⚠️ 避坑小提醒：ESTP性格直爽、玩起来容易忘形，有时会忽略双鱼座敏感脆弱的内心。',
      desc3: '💡 互动升温秘诀：在外疯玩过后，推掉不必要的局，和双鱼座手挽手散步回家。'
    }
  };

  function showQRCode() {
    document.getElementById('qrModal').style.display = 'flex';
  }

  function hideQRCode() {
    document.getElementById('qrModal').style.display = 'none';
  }

  function calculateMatch() {
    const mbti = document.getElementById('mbti').value;
    const zodiac = document.getElementById('zodiac').value;
    if (!mbti || !zodiac) {
      alert('请先选择你的MBTI和星座哦~');
      return;
    }
    const data = targetMap[mbti] || targetMap['ESTP'];
    renderResult({
      userAttr: mbti + ' × ' + zodiac,
      targetType: data.type + ' × ' + data.zodiac,
      scoreNum: '98.6',
      desc0: data.desc0,
      desc1: data.desc1,
      desc2: data.desc2,
      desc3: data.desc3
    });
    document.getElementById('quizSection').style.display = 'none';
    document.getElementById('result').style.display = 'block';
  }

  function renderResult(data) {
    document.getElementById('userAttr').innerText = data.userAttr;
    document.getElementById('targetType').innerText = data.targetType;
    document.getElementById('scoreNum').innerText = data.scoreNum + '%';
    document.getElementById('desc0').innerText = data.desc0;
    document.getElementById('desc1').innerText = data.desc1;
    document.getElementById('desc2').innerText = data.desc2;
    document.getElementById('desc3').innerText = data.desc3;
  }

  window.addEventListener('DOMContentLoaded', async () => {
    const loadingView = document.getElementById('loadingView');
    const contentView = document.getElementById('contentView');
    loadingView.style.display = 'none';
    contentView.style.display = 'block';
  });
</script>
